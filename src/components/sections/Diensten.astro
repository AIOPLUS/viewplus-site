---
/** Diensten in detail (afwisselend beeld links/rechts), zoals de "uitkomsten" op reviewplus.io. */
import { Image } from 'astro:assets';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import Feed from '@/components/mockups/Feed.astro';
import Fotos from '@/components/mockups/Fotos.astro';
import Kalender from '@/components/mockups/Kalender.astro';
import Reacties from '@/components/mockups/Reacties.astro';
import { diensten } from '@/config/content';
import bg from '@/assets/img/uitkomst-bg.png';
---
<section class="py-20 lg:py-28" aria-labelledby="diensten-title">
  <div class="container-rp">
    <SectionHeader id="diensten-title" eyebrow="Wat we doen" line1="Alles uit" line2="handen" class="reveal" />

    <div class="mt-14 grid gap-16 lg:mt-20 lg:gap-24">
      {diensten.map((d, i) => (
        <article id={d.id} class="reveal grid scroll-mt-40 items-center gap-10 lg:grid-cols-2 lg:gap-20">
          <div class:list={['relative isolate grid aspect-[5/4] place-items-center overflow-hidden rounded-[var(--radius-card)] bg-brand-50 p-8 lg:p-14', i % 2 === 1 && 'lg:order-2']}>
            <Image src={bg} alt="" class="absolute inset-0 -z-10 size-full object-cover" widths={[640, 1280]} sizes="(min-width: 1200px) 620px, 100vw" />
            {d.beeld === 'feed' && <Feed class="w-[46%] max-w-[240px] translate-y-[18%]" />}
            {d.beeld === 'fotos' && <Fotos class="w-full" />}
            {d.beeld === 'kalender' && <Kalender class="w-full max-w-[460px]" />}
            {d.beeld === 'engagement' && <Reacties />}
          </div>
          <div class="grid gap-6">
            <p class="flex items-center gap-2 text-sm text-brand-600"><span class="size-1.5 rounded-full bg-brand-600" aria-hidden="true"></span>{d.label}</p>
            <h3 class="heading-md text-ink">{d.titel}</h3>
            <p class="lead text-ink-soft">{d.tekst}</p>
            <ul class="grid gap-3 border-t border-line pt-6">
              {d.punten.map((p) => (
                <li class="flex items-center gap-3 text-ink">
                  <span class="grid size-6 shrink-0 place-items-center rounded-full bg-brand-600 text-white" aria-hidden="true">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                  </span>
                  {p}
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
