---
/**
 * Prijskaarten: een schakelaar tussen de diensten (View Plus Online / Fotografie) met per dienst drie opties,
 * in dezelfde opmaak als de plannen en de factureringsschakelaar op reviewplus.io.
 * Prijzen excl. btw, met het bedrag incl. 21% btw, het totaal en de besparing ten opzichte van de eerste optie.
 * Deeplink: /plans#fotografie opent direct de fotografie.
 */
import { pakketten } from '@/config/content';
import { euro, inclBtwTekst } from '@/lib/prijs';
import { url } from '@/lib/url';

interface Props {
  /** Kop per kaart als h2 (prijzenpagina) of h3 (in een sectie). */
  kop?: 'h2' | 'h3';
}
const { kop: Kop = 'h3' } = Astro.props;
---
<div class="grid gap-12" data-pakketten>
  <div class="mx-auto flex w-fit items-center gap-1 rounded-full bg-brand-100 p-1" role="tablist" aria-label="Kies een dienst">
    {pakketten.map((p, i) => (
      <button
        type="button"
        role="tab"
        id={`tab-${p.id}`}
        aria-controls={`paneel-${p.id}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
        data-pakket-tab={p.id}
        class="rounded-full px-5 py-2.5 text-[15px] text-ink transition-colors aria-selected:bg-white aria-selected:text-brand-600 aria-selected:shadow-sm"
      >{p.naam}</button>
    ))}
  </div>

  {pakketten.map((p, i) => {
    const basis = p.opties[0].bedrag;
    return (
      <div role="tabpanel" id={`paneel-${p.id}`} aria-labelledby={`tab-${p.id}`} hidden={i !== 0} data-pakket-paneel={p.id} class="grid gap-6">
        <p class="text-center text-ink-soft">{p.ondertitel} · prijs per {p.eenheid}, exclusief btw</p>
        <ul class="grid gap-6 lg:grid-cols-3">
          {p.opties.map((o) => (
            <li class:list={['flex flex-col overflow-hidden rounded-[var(--radius-panel)] border', o.uitgelicht ? 'border-brand-600 shadow-[var(--shadow-glow)]' : 'border-brand-200']}>
              <div class:list={['grid gap-4 px-8 pb-12 pt-8 text-white', o.uitgelicht ? 'bg-gradient-to-br from-brand-600 to-brand-500' : 'bg-gradient-to-br from-brand-500 to-brand-400']}>
                <p class="flex items-center justify-between gap-2 text-sm">
                  <span class="flex items-center gap-2"><span class="size-1.5 rounded-full bg-white" aria-hidden="true"></span>{o.label}</span>
                  {o.uitgelicht && <span class="rounded-full bg-white px-2.5 py-0.5 text-xs font-medium text-brand-700">Meest voordelig</span>}
                </p>
                <p class="flex items-end gap-1">
                  <span class="text-[52px] font-medium leading-none tracking-[-0.03em]">€{euro(o.bedrag)}</span>
                  <span class="pb-1 text-sm text-white/85">{p.eenheidKort}</span>
                </p>
                <p class="-mt-2 text-sm text-white/90">€ {inclBtwTekst(o.bedrag)} incl. 21% btw</p>
              </div>
              <div class="-mt-6 flex flex-1 flex-col gap-6 rounded-t-[var(--radius-panel)] bg-white px-8 pb-8 pt-8">
                <div class="grid gap-1">
                  <Kop class="title">{p.naam}<span class="sr-only"> ({o.label})</span></Kop>
                  <p class="text-sm text-muted">{o.looptijd} · € {euro(o.aantal * o.bedrag)} {p.totaalTekst}, excl. btw</p>
                  {o.bedrag < basis && (
                    <p class="text-sm font-medium text-brand-600">Je bespaart € {euro(basis - o.bedrag)} per {p.eenheid}</p>
                  )}
                </div>
                <ul class="grid gap-3 border-t border-line pt-6 text-[15px]">
                  {p.kenmerken.map((k) => (
                    <li class="flex gap-3 text-ink-soft">
                      <svg class="mt-0.5 shrink-0 text-brand-600" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                      {k}
                    </li>
                  ))}
                </ul>
                <a href={url(`/aanmelden?${p.id}=${o.id}`)} class:list={['btn mt-auto w-full', o.uitgelicht ? 'btn-primary' : 'btn-soft']} data-track="prijs_klik" data-track-plek={o.id}>Kies {o.label}</a>
              </div>
            </li>
          ))}
        </ul>
      </div>
    );
  })}
</div>

<script>
  // Tabs: klik of pijltjestoetsen wisselen tussen de diensten. /plans#fotografie opent direct die tab.
  document.querySelectorAll<HTMLElement>('[data-pakketten]').forEach((wrap) => {
    const tabs = [...wrap.querySelectorAll<HTMLButtonElement>('[data-pakket-tab]')];
    const panelen = wrap.querySelectorAll<HTMLElement>('[data-pakket-paneel]');
    const kies = (id: string, focus = false) => {
      tabs.forEach((t) => {
        const actief = t.dataset.pakketTab === id;
        t.setAttribute('aria-selected', String(actief));
        t.tabIndex = actief ? 0 : -1;
        if (actief && focus) t.focus();
      });
      panelen.forEach((p) => (p.hidden = p.dataset.pakketPaneel !== id));
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => kies(t.dataset.pakketTab!));
      t.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        const volgende = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
        kies(volgende.dataset.pakketTab!, true);
      });
    });
    const hash = location.hash.slice(1);
    if (tabs.some((t) => t.dataset.pakketTab === hash)) kies(hash);
  });
</script>
